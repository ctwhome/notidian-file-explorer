{
	"name": "notidian-file-explorer",
	"version": "1.0.12",
	"description": "A multi-column file explorer for Obsidian, similar to macOS Finder's column view.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild tests/explorer-utils.test.ts --bundle --platform=node --outfile=/tmp/notidian-explorer-tests.cjs && node --test /tmp/notidian-explorer-tests.cjs",
		"bump": "node bump-version.mjs",
		"bump:minor": "node bump-version.mjs minor",
		"bump:major": "node bump-version.mjs major",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"overrides": {
		"@codemirror/state": "6.5.0"
	},
	"devDependencies": {
		"@codemirror/commands": "6.9.0",
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/language": "6.11.3",
		"@codemirror/legacy-modes": "^6.5.4",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@lezer/highlight": "^1.2.3",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"docx-preview": "0.4.0",
		"emoji-picker-element": "^1.26.1",
		"esbuild": "0.17.3",
		"jszip": "3.10.1",
		"obsidian": "latest",
		"typescript": "4.7.4",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	}
}
